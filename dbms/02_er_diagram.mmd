erDiagram
    USER ||--o{ QUEUETICKET : "gets"
    LOCATION ||--o{ QUEUETICKET : "has"

    USER {
        int id PK
        string name
        string email UK
        string passwordHash
        Role role "STUDENT, STAFF, ADMIN"
        datetime createdAt
    }

    LOCATION {
        int id PK
        string name UK
        string description "optional"
        int avgServiceMinutes
        datetime createdAt
    }

    QUEUETICKET {
        int id PK
        int ticketNumber "unique with locationId"
        TicketStatus status "WAITING, CALLED, COMPLETED, CANCELLED"
        datetime createdAt
        datetime calledAt "optional"
        datetime completedAt "optional"
        int userId FK
        int locationId FK
    }
