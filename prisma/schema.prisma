// Prisma schema for QueueBee.
// Three models only:  User  ->  QueueTicket  <-  Location
//   * One User can have many QueueTickets   (one-to-many)
//   * One Location can have many QueueTickets (one-to-many)
//   * Each QueueTicket belongs to exactly one User and one Location

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The three roles used for role-based access control (RBAC)
enum Role {
  STUDENT
  STAFF
  ADMIN
}

// Life cycle of a ticket: WAITING -> CALLED -> COMPLETED   (or WAITING -> CANCELLED)
enum TicketStatus {
  WAITING
  CALLED
  COMPLETED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   // we never store the real password, only the bcrypt hash
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  tickets QueueTicket[]
}

// A campus service point, e.g. Canteen, Library Desk, Fee Office
model Location {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  description       String?
  avgServiceMinutes Int      @default(5) // average minutes to serve one student
  createdAt         DateTime @default(now())

  tickets QueueTicket[]
}

model QueueTicket {
  id           Int          @id @default(autoincrement())
  ticketNumber Int          // running number inside one location: 1, 2, 3 ...
  status       TicketStatus @default(WAITING)
  createdAt    DateTime     @default(now())
  calledAt     DateTime?
  completedAt  DateTime?

  // Foreign keys + relations
  userId     Int
  locationId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // The same ticket number can never be used twice in one location
  @@unique([locationId, ticketNumber])
  // Makes "find waiting tickets of a location" queries fast
  @@index([locationId, status])
}
